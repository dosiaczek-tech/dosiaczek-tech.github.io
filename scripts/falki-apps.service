[Unit]
Description=Falki and SUP local apps with automatic forecast refresh
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=/home/dosiaczek/opencode/dosiaczek-tech.github.io
ExecStart=/run/current-system/sw/bin/nix-shell --run "exec node scripts/dev-server.cjs"
Restart=always
RestartSec=5
TimeoutStopSec=20

[Install]
WantedBy=default.target
